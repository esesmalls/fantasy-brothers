    "compose_order": [
      "own edit: position += offset, size *= scale, rotation = deg_to_rad(angle) when angle is not zero",
      "child hair/beard/scar/bandage/blood: anchor is the pre-edit parent position; position = anchor + ((position-anchor)*parent.scale).rotated(parent.angle) + parent.offset; size *= parent.scale; rotation += parent radians",
      "bust translation added only to GROUPS.bust; base and weapons are excluded"
    ],
