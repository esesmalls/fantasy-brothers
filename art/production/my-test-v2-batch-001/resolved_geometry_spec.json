  "coordinate_convention": {
    "space": "board logical pixels",
    "origin": "ground contact used as the part origin by static_bust_actor.draw_part; catalog base position is [0, 0] and its pivot is [0.5, 1], the bottom center of the 64-wide base",
    "axes": "+x right, +y down, Godot CanvasItem space",
    "pivot": "normalized 0..1 of the part logical size. part_point = (point - pivot*size).rotated(rotation_rad) + position",
    "screen": "origin + logical_point * scale_value. scale_value is the draw call argument, not a second fit stored on the part",
    "bust_alignment_shift": {
      "catalog_value": [
        2,
        0
      ],
      "runtime": "present only in catalog.json and catalog-v3.json. No GDScript reads bust_alignment_shift, so composed() does not add it again."
    }
  },
